# AI demo credentials — copy these lines into the repo-root .env (which
# docker-compose already loads for CP_VERSION etc.) rather than committing
# real values here.
#
# AWS credentials with bedrock:InvokeModelWithResponseStream on BEDROCK_MODEL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=        # only if using temporary/STS credentials
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
