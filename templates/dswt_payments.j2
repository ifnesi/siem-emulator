{#- DSWT e-commerce demo — PAYMENTS fact stream (bounded, one per order).
    Produce with `-n <NUM_ORDERS> -k order_id`: walks order_id 0..NUM_ORDERS-1
    and stops. `amount` recomputes the SAME per-line item sum as
    dswt_orders.order_total (see the shared item model in dswt_orders.j2), so
    amount == order_total == sum of the order's line_totals — exactly. ~1 in 10
    DECLINED. authorized_ts is on the shared per-order timeline (see
    dswt_orders.j2): the order time + a seeded 1..15 min, so the payment lands
    just after the order on one coherent clock. -#}
{%- set oid = counter("orders", 0, 1) -%}
{%- set order_id = "ORD-%08d"|format(oid) -%}
{%- set order_ms = 1767225600000 + oid * 300000 -%}
{%- set authorized_ms = order_ms + seeded_integer("paydelay-%d"|format(oid), 60, 900) * 1000 -%}
{%- set item_count = seeded_integer("ic-%d"|format(oid), 2, 5) -%}
{%- set ns = namespace(total=0.0) -%}
{%- for L in range(1, item_count + 1) -%}
  {%- set sku_num = seeded_integer("sku-%d-%d"|format(oid, L), 0, 99) -%}
  {%- set unit_price = seeded_floating(sku_num, 5.0, 500.0, 2) -%}
  {%- set quantity = seeded_integer("qty-%d-%d"|format(oid, L), 1, 4) -%}
  {%- set ns.total = ns.total + (unit_price * quantity) -%}
{%- endfor -%}
{%- set status = seeded_choice("pstat-%d"|format(oid), "CAPTURED|CAPTURED|CAPTURED|CAPTURED|CAPTURED|CAPTURED|CAPTURED|CAPTURED|CAPTURED|DECLINED") -%}
{
  "order_id":       {{ order_id | tojson }},
  "payment_method": {{ seeded_choice("pm-%d"|format(oid), data.payment_methods) | tojson }},
  "amount":         {{ ns.total | round(2) }},
  "currency":       "GBP",
  "status":         {{ status | tojson }},
  "authorized_ts":  {{ epoch_millis(authorized_ms) }}
}
